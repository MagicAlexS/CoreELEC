-    return true;
-  }
-
-  CLog::Log(LOGDEBUG, "CDVDInputStreamBluray::OnMenu - root failed, trying explicit");
-  if (bd_menu_call(m_bd, -1) <= 0)
-  {
-    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray::OnMenu - root failed");
-    return false;
