+bool CDVDInputStreamBluray::SelectStreamByPid(int pid, bool audio, bool enable)
+{
+  if (!m_navmode || !m_bd || !m_clip || pid < 0)
+    return false;
+
+  const BLURAY_STREAM_INFO* streams =
+      audio ? m_clip->audio_streams : m_clip->pg_streams;
+  const uint32_t streamCount =
+      audio ? m_clip->audio_stream_count : m_clip->pg_stream_count;
+  uint32_t streamId = 0;
+  for (uint32_t i = 0; i < streamCount; ++i)
+  {
+    if (streams[i].pid == pid)
+    {
+      streamId = i + 1;
+      break;
+    }
+  }
+  if (streamId == 0)
+  {
+    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray::SelectStreamByPid - PID {} not in current clip",
+              pid);
+    return false;
+  }
+
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+
+  const int ret = bd_select_stream(m_bd, audio ? BLURAY_AUDIO_STREAM : BLURAY_PG_TEXTST_STREAM,
+                                   streamId, audio ? 1 : (enable ? 1 : 0));
+
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+
+  if (ret < 0)
+  {
+    CLog::Log(LOGWARNING, "CDVDInputStreamBluray::SelectStreamByPid - libbluray rejected type {}",
+              audio ? "audio" : "subtitle");
+    return false;
+  }
+
+  if (audio)
+  {
+    // Audio selection returns 1 when accepted, including when already selected.
+    // If no event was needed, retain the confirmed register value for later checks.
+    if (ret > 0 && !m_audioStreamIdKnown)
+    {
+      m_audioStreamId = streamId;
+      m_audioStreamIdKnown = true;
+    }
+    return m_audioStreamIdKnown && m_audioStreamId == streamId;
+  }
+
+  // PG may change the stream and visibility independently if one UO is masked.
+  // Confirm both values from the resulting event state to avoid reporting success
+  // when only one part of the request was applied.
+  return m_pgStreamIdKnown && m_pgStreamId == streamId && m_pgTextstEnabledKnown &&
+         m_pgTextstEnabled == enable;
+}
+
+bool CDVDInputStreamBluray::SetSubtitleVisible(bool visible)
+{
+  if (!m_navmode || !m_bd || !m_clip || !m_pgStreamIdKnown || !m_pgTextstEnabledKnown)
+    return false;
+
+  if (m_pgStreamId == 0)
+    return !visible && !m_pgTextstEnabled;
+
+  if (m_pgStreamId > m_clip->pg_stream_count)
+    return false;
+
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+
+  const int ret = bd_select_stream(m_bd, BLURAY_PG_TEXTST_STREAM, m_pgStreamId,
+                                   visible ? 1 : 0);
+
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+
+  if (ret < 0)
+    return false;
+
+  // A zero return can mean no change or a UO restriction. The cached state is
+  // updated only by libbluray events, so it distinguishes those outcomes.
+  return m_pgStreamIdKnown && m_pgTextstEnabledKnown &&
+         m_pgTextstEnabled == visible && m_pgStreamId != 0;
+}
