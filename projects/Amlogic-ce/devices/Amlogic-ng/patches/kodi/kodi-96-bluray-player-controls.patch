+  if (!m_bd || !m_navmode)
+    return false;
+
+  // Consume queued navigation before installing a new menu command.
+  ProcessEvent();
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+
+  int ret = bd_user_input(m_bd, -1, BD_VK_POPUP);
+  if (ret < 0)
+  {
+    CLog::Log(LOGDEBUG, "CDVDInputStreamBluray::OnMenu - trying root menu");
+    // ROOT_MENU is bd_menu_call internally: zero means it was not accepted.
+    ret = bd_menu_call(m_bd, -1);
+    if (ret <= 0)
+      return false;
+  }
+
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+
+  // A menu button can install HDMV VM commands while input is held at EOF.
+  // Only poll an activation, never resume the default end program for a no-op.
+  if (m_titleEndPending && ret > 0)
+  {
+    for (int i = 0; i < 100; ++i)
+    {
+      if (bd_read_ext(m_bd, nullptr, 0, &m_event) < 0 || m_event.event == BD_EVENT_NONE)
+        break;
+      ProcessEvent();
+    }
+  }
+  CLog::Log(LOGINFO, "CDVDInputStreamBluray::OnMenu - menu request accepted ({})", ret);
   return true;
 }
 
