 #define SETTING_SUBTITLE_SEARCH                "subtitles.search"
 #define SETTING_MAKE_DEFAULT                   "audio.makedefault"
 
+namespace
+{
+std::string GetSubtitleBrowseDirectory(std::string path)
+{
+  // Disc and archive URLs keep their real source in the encoded hostname.
+  // Unwrap nested bluray://udf:// URLs to the image's containing directory.
+  while (!path.empty())
+  {
+    const CURL url(path);
+    if (!(url.IsProtocol("bluray") || url.IsProtocol("udf") || url.IsProtocol("rar") ||
+          url.IsProtocol("zip")) || url.GetHostName().empty() || url.GetHostName() == path)
+      break;
+    path = url.GetHostName();
+  }
+
+  if (path.empty() || URIUtils::IsPlugin(path))
+    return {};
+
+  const std::string directory = URIUtils::HasSlashAtEnd(path)
+                                    ? path
+                                    : CFileItem(path, false).GetLocalMetadataPath();
+  // GetLocalMetadataPath handles BDMV/index.bdmv and VIDEO_TS.IFO. Also
+  // handle playback paths inside BDMV/PLAYLIST, BDMV/STREAM and BACKUP.
+  std::string ancestor = directory;
+  while (!ancestor.empty())
+  {
+    std::string folder = ancestor;
+    URIUtils::RemoveSlashAtEnd(folder);
+    const std::string name = URIUtils::GetFileName(folder);
+    if (StringUtils::EqualsNoCase(name, "BDMV") || StringUtils::EqualsNoCase(name, "VIDEO_TS"))
+      return URIUtils::GetParentPath(ancestor);
+    const std::string parent = URIUtils::GetParentPath(ancestor);
+    if (parent == ancestor)
+      break;
+    ancestor = parent;
+  }
+  return directory;
+}
+} // namespace
