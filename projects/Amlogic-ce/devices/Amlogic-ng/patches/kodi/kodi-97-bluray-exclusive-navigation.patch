+
+bool CDVDInputStreamBluray::CloseMenu()
+{
+  if (!m_bd || !m_navmode)
+    return false;
+  const int ret = bd_menu_close(m_bd);
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+  CLog::Log(LOGINFO, "CDVDInputStreamBluray::CloseMenu - close result {}", ret);
+  return ret > 0 || !IsInMenu();
+}
+
+bool CDVDInputStreamBluray::NavigateBack()
+{
+  if (!m_bd || !m_navmode || !IsInMenu())
+    return false;
+
+  // Back is a graphics-only operation. Do not call bd_read_ext here: polling
+  // the VM could advance a buffered title end instead of only returning a page.
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+  const int ret = bd_menu_back(m_bd);
+  while (bd_get_event(m_bd, &m_event))
+    ProcessEvent();
+  CLog::Log(LOGINFO, "CDVDInputStreamBluray::NavigateBack - page result {}", ret);
+  return ret > 0;
 }
 
