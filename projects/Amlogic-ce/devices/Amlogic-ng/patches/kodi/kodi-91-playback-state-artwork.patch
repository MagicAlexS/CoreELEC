+TEST(TestFileItem, PlaybackStateUpdatePreservesLibraryArt)
+{
+  CFileItem libraryItem("videodb://movies/titles/1346/", false);
+  libraryItem.GetVideoInfoTag()->m_iDbId = 1346;
+  libraryItem.GetVideoInfoTag()->m_type = "movie";
+  libraryItem.SetArt("poster", "poster.jpg");
+  libraryItem.SetArt("thumb", "library-thumb.jpg");
+  libraryItem.SetArt("fanart", "fanart.jpg");
+  libraryItem.SetArt("landscape", "landscape.jpg");
+  libraryItem.SetArt("backdrop", "backdrop.jpg");
+  libraryItem.SetProperty("libraryartfilled", true);
+
+  CFileItem playbackUpdate("nfs://media/movie/BDMV/index.bdmv", false);
+  playbackUpdate.GetVideoInfoTag()->m_iDbId = 1346;
+  playbackUpdate.GetVideoInfoTag()->m_type = "movie";
+  playbackUpdate.SetArt("thumb", "image://video@nfs://media/movie/BDMV/index.bdmv/");
+  CBookmark resumePoint;
+  resumePoint.timeInSeconds = 1175.0;
+  resumePoint.totalTimeInSeconds = 6000.0;
+  playbackUpdate.GetVideoInfoTag()->SetResumePoint(resumePoint);
+
+  // Mirrors the art-free playback state notification sent by SaveFileStateJob.
+  playbackUpdate.ClearArt();
+  libraryItem.UpdateInfo(playbackUpdate);
+
+  EXPECT_EQ("poster.jpg", libraryItem.GetArt("poster"));
+  EXPECT_EQ("library-thumb.jpg", libraryItem.GetArt("thumb"));
+  EXPECT_EQ("fanart.jpg", libraryItem.GetArt("fanart"));
+  EXPECT_EQ("landscape.jpg", libraryItem.GetArt("landscape"));
+  EXPECT_EQ("backdrop.jpg", libraryItem.GetArt("backdrop"));
+  EXPECT_DOUBLE_EQ(1175.0, libraryItem.GetVideoInfoTag()->GetResumePoint().timeInSeconds);
+  EXPECT_FALSE(libraryItem.GetProperty("libraryartfilled").asBoolean());
+}
