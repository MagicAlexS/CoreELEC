 INSTANTIATE_TEST_SUITE_P(NoArt, TestFileItemFallbackArt, ValuesIn(NoArtFiles));
 
+TEST(TestFileItem, PlaybackStateReceiversRetainCompleteLibraryArt)
+{
+  CFileItem libraryItem("videodb://movies/titles/1346/", false);
+  libraryItem.GetVideoInfoTag()->m_iDbId = 1346;
+  libraryItem.GetVideoInfoTag()->m_type = "movie";
+  libraryItem.SetArt("poster", "poster.jpg");
+  libraryItem.SetArt("thumb", "library-thumb.jpg");
+  libraryItem.SetArt("fanart", "fanart.jpg");
+  libraryItem.SetArt("landscape", "landscape.jpg");
+  libraryItem.SetArt("backdrop", "backdrop.jpg");
+  libraryItem.SetProperty("libraryartfilled", true);
+
+  CFileItem playbackUpdate("nfs://media/movie/BDMV/index.bdmv", false);
+  playbackUpdate.GetVideoInfoTag()->m_iDbId = 1346;
+  playbackUpdate.GetVideoInfoTag()->m_type = "movie";
+  playbackUpdate.SetArt("thumb", "image://video@nfs://media/movie/BDMV/index.bdmv/");
+  // Model FillLibraryArt merging the database art into the sparse playback item.
+  playbackUpdate.AppendArt(libraryItem.GetArt());
+  CBookmark resumePoint;
+  resumePoint.timeInSeconds = 1175.0;
+  resumePoint.totalTimeInSeconds = 6000.0;
+  playbackUpdate.GetVideoInfoTag()->SetResumePoint(resumePoint);
+
+  CFileItem updateInfoReceiver(libraryItem);
+  updateInfoReceiver.UpdateInfo(playbackUpdate);
+
+  CFileItem replacingReceiver(libraryItem);
+  replacingReceiver = playbackUpdate;
+
+  const auto expectPlaybackStateAndArt = [](const CFileItem& updatedItem)
+  {
+    EXPECT_EQ("poster.jpg", updatedItem.GetArt("poster"));
+    EXPECT_EQ("library-thumb.jpg", updatedItem.GetArt("thumb"));
+    EXPECT_EQ("fanart.jpg", updatedItem.GetArt("fanart"));
+    EXPECT_EQ("landscape.jpg", updatedItem.GetArt("landscape"));
+    EXPECT_EQ("backdrop.jpg", updatedItem.GetArt("backdrop"));
+    EXPECT_DOUBLE_EQ(1175.0,
+                     updatedItem.GetVideoInfoTag()->GetResumePoint().timeInSeconds);
+  };
+
+  expectPlaybackStateAndArt(updateInfoReceiver);
+  expectPlaybackStateAndArt(replacingReceiver);
+}
