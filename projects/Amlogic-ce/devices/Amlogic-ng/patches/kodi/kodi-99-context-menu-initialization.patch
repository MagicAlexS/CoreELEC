Subject: [PATCH] ContextMenu: restore choices after resource reallocation

--- a/xbmc/dialogs/GUIDialogContextMenu.cpp
+++ b/xbmc/dialogs/GUIDialogContextMenu.cpp
@@ -105,6 +105,14 @@
 
 void CGUIDialogContextMenu::OnInitWindow()
 {
+  // Conditional resource allocation may have reloaded the controls after
+  // Show/ShowAndGetChoice prepared the choices. Restore them before focus
+  // initialization, without duplicating controls on the normal path.
+  if (!m_buttons.empty() && !GetControl(BUTTON_START))
+  {
+    SetInitialVisibility();
+    SetupButtons();
+  }
   m_clickedButton = -1;
   // set initial control focus
   m_lastControlID = m_initiallyFocusedButtonIdx + BUTTON_START;
