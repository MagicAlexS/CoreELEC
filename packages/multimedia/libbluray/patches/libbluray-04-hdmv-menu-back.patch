+int bd_menu_back(BLURAY *bd)
+{
+    int result = 0;
+
+    if (!bd) {
+        return -1;
+    }
+
+    bd_mutex_lock(&bd->mutex);
+
+    if (bd->title_type == title_hdmv && bd->graphics_controller && bd->hdmv_vm) {
+        result = _run_gc(bd, GC_CTRL_MENU_BACK, 0);
+    }
+
+    bd_mutex_unlock(&bd->mutex);
+
+    return result;
+}
+
+int bd_menu_close(BLURAY *bd)
+{
+    int result = 0;
+
+    if (!bd) {
+        return -1;
+    }
+
+    bd_mutex_lock(&bd->mutex);
+
+    if (bd->title_type == title_hdmv && bd->graphics_controller && bd->hdmv_vm) {
+        result = _run_gc(bd, GC_CTRL_MENU_CLOSE, 0);
+    }
+
+    bd_mutex_unlock(&bd->mutex);
+
+    return result;
+}
