+static void _record_back_history(GRAPHICS_CONTROLLER *gc, uint16_t current_page_id,
+                                 uint16_t current_button_id, uint16_t target_page_id)
+{
+    unsigned ii;
+
+    if (!gc->back_history_active) {
+        return;
+    }
+
+    for (ii = 0; ii < gc->back_history_count; ii++) {
+        if (gc->back_history[ii].page_id == target_page_id) {
+            /* Returning to an earlier page discards the forward path. */
+            gc->back_history_count = ii;
+            return;
+        }
+    }
+
+    if (gc->back_history_count == GC_BACK_HISTORY_MAX) {
+        memmove(gc->back_history, gc->back_history + 1,
+                (GC_BACK_HISTORY_MAX - 1) * sizeof(gc->back_history[0]));
+        gc->back_history_count--;
+    }
+
+    gc->back_history[gc->back_history_count].page_id = current_page_id;
+    gc->back_history[gc->back_history_count].button_id = current_button_id;
+    gc->back_history_count++;
+}
+
+static int _menu_back(GRAPHICS_CONTROLLER *gc, GC_NAV_CMDS *cmds)
+{
+    PG_DISPLAY_SET *s;
+    BD_IG_PAGE *page;
+    GC_BACK_STATE target;
+    int result;
+
+    if (gc->ig_explicitly_closed || !gc->back_history_active || !gc->back_history_count) {
+        return 0;
+    }
+
+    s = gc->igs;
+    if (!s || !s->ics) {
+        gc->back_history_count = 0;
+        return 0;
+    }
+
+    target = gc->back_history[gc->back_history_count - 1];
+    page = _find_page(&s->ics->interactive_composition, target.page_id);
+    if (!page || !_find_palette(s, page->palette_id_ref)) {
+        /* Do not retain history that cannot be rendered in this display set. */
+        gc->back_history_count = 0;
+        return 0;
+    }
+
+    _select_page(gc, target.page_id, 0);
+    if (target.button_id != 0xffff &&
+        _find_button_page(page, target.button_id, NULL) &&
+        _is_button_enabled(gc, page, target.button_id)) {
+        _select_button(gc, target.button_id);
+    }
+
+    /* Back restores focus; it must not trigger an auto-action on the page. */
+    gc->auto_action_triggered = 1;
+    result = _render_page(gc, 0xffff, cmds);
+    if (result < 0) {
+        return -1;
+    }
+
+    gc->back_history_count--;
+    return 1;
+}
+
+static int _menu_close(GRAPHICS_CONTROLLER *gc, GC_NAV_CMDS *cmds)
+{
+    unsigned ii;
+    const int was_open = gc->ig_open || gc->ig_drawn;
+
+    gc->ig_explicitly_closed = 1;
+    gc->popup_visible = 0;
+    gc->ig_dirty = 0;
+    gc->ig_drawn = 0;
+    gc->button_effect_running = 0;
+    gc->button_animation_running = 0;
+    gc->in_effects = NULL;
+    gc->out_effects = NULL;
+    gc->effect_idx = 0;
+    gc->user_timeout = 0;
+    gc->valid_mouse_position = 0;
+    gc->page_uo_mask = uo_mask_get_empty();
+
+    if (was_open) {
+        _close_osd(gc, BD_OVERLAY_IG);
+    }
+
+    /* The closed plane has no cached button pixels; keep menu selection state. */
+    for (ii = 0; ii < MAX_NUM_BOGS; ii++) {
+        gc->bog_data[ii].x = 0;
+        gc->bog_data[ii].y = 0;
+        gc->bog_data[ii].w = 0;
+        gc->bog_data[ii].h = 0;
+        gc->bog_data[ii].visible_object_id = -1;
+    }
+
+    /* Popup status means that a popup menu is loaded, not currently visible. */
+    if (cmds && gc->igs && gc->igs->ics &&
+        gc->igs->ics->interactive_composition.ui_model == IG_UI_MODEL_POPUP) {
+        cmds->status |= GC_STATUS_POPUP;
+    }
+
+    return was_open;
+}
